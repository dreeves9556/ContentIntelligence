generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String        @id @default(uuid())
  email              String?       @unique
  emailVerified      DateTime?
  name               String?
  password           String? // For credentials auth, nullable for OAuth
  image              String?
  role               UserRole      @default(USER)
  plan               UserPlan      @default(PRO)
  tokenVersion       Int           @default(0) // Incremented on password reset to invalidate existing JWTs
  emailUnsubscribed  Boolean       @default(false) // User opted out of broadcast emails
  authorDisplayName  String? // Public byline name shown on articles
  authorImage        String? // URL to headshot
  authorOrganization String? // Optional org/title shown under name
  authorContactEmail String? // Optional contact email shown as mailto link in byline
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Account cohort & access management (pre-Stripe)
  accountStatus     AccountStatus    @default(ACTIVE)
  internalTag       String?
  isComped          Boolean          @default(false)
  compReason        String?
  accessExpiresAt   DateTime?
  expirationAction  ExpirationAction @default(NONE)
  lastAccessCheckAt DateTime?

  // Stripe fields — populated by Stripe webhook integration
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripeStatus         String?

  // Trial tracking
  hasUsedTrial             Boolean   @default(false)
  trialEndsAt              DateTime?
  trialWillEndNotifiedAt   DateTime?

  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  questionnaires             Questionnaire[]
  calendars                  Calendar[]
  socialTokens               SocialToken[]
  adminMessages              AdminMessage[]
  socialProfiles             SocialProfile[]
  postAnalytics              PostAnalytics[]
  contentArchives            ContentArchive[]
  contentFeedback            ContentFeedback[]
  pushSubscriptions          PushSubscription[]
  profileSurveys             ProfileSurvey[]
  zernioAccounts             ZernioAccount[]
  bestTimeToPosts            BestTimeToPost[]
  followerStats              FollowerStats[]
  deepAnalytics              DeepAnalytics[]
  resourcePosts              ResourcePost[]
  bugReports                 BugReport[]
  creatorMemories            CreatorMemory[]
  calendarGenerationLogs     CalendarGenerationLog[]
  posts                      Post[]
  postRefinementSessions     PostRefinementSession[]
  notificationLogs           NotificationLog[]
  notificationPreference     NotificationPreference?
  scheduledPushNotifications ScheduledPushNotification[] @relation("ScheduledPushCreator")
  memberGrowthBaselines      MemberGrowthBaseline[]
  impactConnectionPeriods    ImpactConnectionPeriod[]
  analyticsSyncJobs          AnalyticsSyncJob[]
  loginAnnouncementDismissals LoginAnnouncementDismissal[]
  accounts                   Account[]
  sessions                   Session[]
  listings                   Listing[]
  listingContents            ListingContent[]
  listingLibraryItems        ListingLibraryItem[]
  listingGenerationRequests  ListingGenerationRequest[]

  @@index([internalTag])
  @@index([accountStatus])
  @@index([accessExpiresAt])
  @@index([stripeCustomerId])
  @@index([trialEndsAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Questionnaire {
  id          String   @id @default(uuid())
  title       String
  description String?
  content     Json // Store questionnaire structure as JSON
  isPublished Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("questionnaires")
}

model Calendar {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber       Int      @default(1)
  contentJson      Json
  weekStarting     DateTime?
  generationStatus String   @default("COMPLETED")
  model            String?
  promptVersion    String?
  generationLogId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  posts           Post[]
  generationLog   CalendarGenerationLog? @relation(fields: [generationLogId], references: [id], onDelete: SetNull)

  @@map("calendars")
}

model AnalyticsCache {
  id        String    @id @default(uuid())
  key       String    @unique
  data      Json
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("analytics_cache")
}

model SocialToken {
  id           String         @id @default(uuid())
  provider     SocialProvider
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([userId, provider])
  @@map("social_tokens")
}

model AdminMessage {
  id        String   @id @default(uuid())
  subject   String
  message   String
  isRead    Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_messages")
}

model InviteToken {
  id              String        @id @default(cuid())
  email           String        @unique
  token           String        @unique
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  plan            UserPlan      @default(PRO)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedByUserId String?
  inviteSource    String? // "ADMIN" | "TEAM_ADMIN"
  inviteRole      UserRole      @default(USER) // Role the registering user should receive

  @@map("invite_tokens")
}

model PendingStripeInvite {
  id                   String   @id @default(cuid())
  email                String
  token                String   @unique
  purchaseType         String // "solo" | "community"
  billingInterval      String // "monthly" | "annual"
  organizationName     String?
  seats                Int?
  stripeCustomerId     String
  stripeSubscriptionId String
  stripeStatus         String?
  hasUsedTrial         Boolean  @default(false)
  trialEndsAt          DateTime?
  plan                 UserPlan @default(PRO)
  inviteRole           UserRole @default(USER)
  organizationId       String?
  expiresAt            DateTime
  emailSentAt          DateTime?
  lastEmailError       String?
  createdAt            DateTime @default(now())

  @@index([email])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("pending_stripe_invites")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@map("password_reset_tokens")
}

enum UserRole {
  USER
  TEAM_ADMIN
  ADMIN
}

enum UserPlan {
  CALENDAR_ONLY
  PRO
}

enum AccountStatus {
  ACTIVE
  TRIAL
  COMPED
  EXPIRED
  PAST_DUE
  CANCELED
  ARCHIVED
}

enum ExpirationAction {
  NONE
  DOWNGRADE_TO_CALENDAR_ONLY
  DISABLE_ACCESS
}

model SocialProfile {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String // e.g., "INSTAGRAM"
  accountId   String // The external ID
  accessToken String?
  handle      String?
  connectedAt DateTime @default(now())

  @@map("social_profiles")
}

model ContentArchive {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStarting    String
  dayIndex        Int
  day             String
  format          String
  bucket          String
  title           String
  hook            String
  body            String
  cta             String
  caption         String
  musicSuggestion String?
  duration        String?
  archivedAt      DateTime @default(now())

  @@unique([userId, weekStarting, dayIndex])
  @@map("content_archives")
}

model ContentFeedback {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStarting String
  dayIndex     Int
  title        String
  format       String
  bucket       String
  feedback     String // "up" | "down"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, weekStarting, dayIndex])
  @@map("content_feedback")
}

model PostAnalytics {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId  String? // Platform post ID from Zernio
  title       String
  format      String // REEL, CAROUSEL, STATIC or platform name
  platform    String? // normalized social platform; null only for legacy/unattributed rows
  isDemo      Boolean  @default(false)
  publishedAt DateTime
  views       Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  postUrl     String? // Direct URL to the post on the platform

  @@unique([externalId, userId])
  @@index([userId, platform, publishedAt])
  @@index([isDemo])
  @@map("post_analytics")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
}

enum SocialProvider {
  GOOGLE
  FACEBOOK
  TWITTER
  LINKEDIN
  GITHUB
}

model ProfileSurvey {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surveyType  String
  answersJson Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, surveyType])
  @@map("profile_surveys")
}

model ZernioAccount {
  id                  String                  @id @default(cuid())
  userId              String
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  zernioProfileId     String
  zernioAccountId     String
  platform            String // e.g. "instagram", "tiktok", "linkedin"
  handle              String?
  connectedAt         DateTime                @default(now())
  lastSyncAt          DateTime?
  connectionPeriodId  String?                  @unique
  connectionPeriod    ImpactConnectionPeriod? @relation(fields: [connectionPeriodId], references: [id], onDelete: SetNull)

  @@unique([userId, platform])
  @@index([connectionPeriodId])
  @@map("zernio_accounts")
}

model ImpactConnectionPeriod {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          String
  connectedAt       DateTime
  disconnectedAt    DateTime?
  providerAccountId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  account           ZernioAccount?
  baselines         MemberGrowthBaseline[]
  syncJobs          AnalyticsSyncJob[]

  @@index([userId, platform, connectedAt])
  @@index([platform, disconnectedAt])
  @@map("impact_connection_periods")
}

model AnalyticsSyncJob {
  id                 String                 @id @default(cuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform           String
  connectionPeriodId String?
  connectionPeriod   ImpactConnectionPeriod? @relation(fields: [connectionPeriodId], references: [id], onDelete: SetNull)
  source             String                 @default("SCHEDULED")
  status             String                 @default("PENDING")
  scheduledFor       DateTime               @default(now())
  claimToken         String?
  claimedAt          DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  attempts           Int                    @default(0)
  postsSynced        Int                    @default(0)
  followerPointsSynced Int                  @default(0)
  analyticsSucceeded Boolean                @default(false)
  followerStatsSucceeded Boolean            @default(false)
  lastError          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status, scheduledFor])
  @@index([status, claimedAt])
  @@index([userId, platform, status])
  @@map("analytics_sync_jobs")
}

model ImpactBaselineRebuildRun {
  id                String                      @id @default(cuid())
  requestedByUserId String
  status            String                      @default("PREVIEW")
  definitionVersion String
  sourceFingerprint String
  appliedAt         DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  items             ImpactBaselineRebuildItem[]

  @@index([status, createdAt])
  @@map("impact_baseline_rebuild_runs")
}

model ImpactBaselineRebuildItem {
  id                 String                   @id @default(cuid())
  runId              String
  run                ImpactBaselineRebuildRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId             String
  platform           String
  connectionPeriodId String?
  oldBaselineDate    DateTime?
  oldFollowerCount   Int?
  proposedDate       DateTime?
  proposedFollowerCount Int?
  proposedEngagementRate Float?
  status             String                   @default("PENDING")
  reason             String?
  appliedAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([runId, userId, platform])
  @@index([userId, platform, status])
  @@map("impact_baseline_rebuild_items")
}

model PlatformConfig {
  id                             String   @id @default("default")
  zernioApiKey                   String?
  zernioEnabledPlatforms         String[] @default(["instagram", "tiktok", "facebook", "youtube"])
  analyticsSyncFrequencyMinutes  Int      @default(180)
  anthropicModel                 String   @default("claude-opus-4-8")
  anthropicApiKey                String?
  insightPromptTemplate          String?
  calendarPromptTemplate         String?
  calendarStrategyPromptTemplate String?
  notifyOnSignup                 Boolean  @default(false)
  adminNotifyEmail               String?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@map("platform_config")
}

model ResourcePost {
  id          String    @id @default(cuid())
  title       String
  content     String // HTML from Tiptap
  category    String? // e.g. "Strategy", "Tools", "Mindset"
  published   Boolean   @default(false)
  publishedAt DateTime?
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("resource_posts")
}

enum BugReportStatus {
  OPEN
  INVESTIGATED
  SOLVED
}

model BugReport {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  email       String
  deviceInfo  String // "mobile" or "browser" — user-reported
  description String
  status      BugReportStatus @default(OPEN)
  adminNotes  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("bug_reports")
}

model FollowerStats {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform      String // e.g. "instagram", "tiktok", "linkedin"
  date          DateTime // The day the follower count was recorded (date-only, stored at midnight UTC)
  followerCount Int      @default(0)
  growthDelta   Int      @default(0) // net new followers vs previous day
  growthPercent Float    @default(0) // percentage growth vs previous day
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, platform, date])
  @@map("follower_stats")
}

model BestTimeToPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String // e.g. "instagram", "tiktok", "linkedin"
  heatmap   Json // { grid: number[7][24], bestSlots: [{day,hour,engagement}] }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform])
  @@map("best_time_to_post")
}

model DeepAnalytics {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String // e.g. "instagram", "youtube", "tiktok", "linkedin", "facebook"
  dataType  String // e.g. "demographics", "account_insights", "retention", "channel_insights", etc.
  data      Json // Normalized deep analytics payload
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform, dataType])
  @@map("deep_analytics")
}

enum MemoryType {
  IDENTITY
  VOICE
  AUDIENCE
  CONTENT
  PERFORMANCE
  STRATEGY
  PREFERENCE
  WARNING
}

enum Importance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MemorySource {
  QUESTIONNAIRE
  PROFILE_SURVEY
  ANALYTICS
  CONTENT_FEEDBACK
  AI_GENERATED
  ADMIN
  SYSTEM
}

model CreatorMemory {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryType MemoryType
  title      String
  summary    String
  evidence   String?
  confidence Int          @default(50) // 0-100
  importance Importance   @default(MEDIUM)
  source     MemorySource @default(SYSTEM)
  metadata   Json?
  embedding  String? // Nullable — reserved for future vector support (pgvector / OpenAI embeddings)
  pinned     Boolean      @default(false) // User-pinned memories always included in prompts
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  lastUsedAt DateTime?

  @@index([userId, memoryType])
  @@index([userId, importance])
  @@map("creator_memories")
}

model ScheduledBroadcast {
  id           String           @id @default(cuid())
  subject      String
  htmlContent  String
  segment      String
  scheduledFor DateTime
  status       String           @default("PENDING") // PENDING, SENT, CANCELLED, FAILED
  sentCount    Int              @default(0)
  failedCount  Int              @default(0)
  errors       Json?
  createdBy    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  emails       BroadcastEmail[]

  @@index([status, scheduledFor])
  @@map("scheduled_broadcasts")
}

model BroadcastEmail {
  id             String             @id @default(cuid())
  broadcastId    String
  broadcast      ScheduledBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  recipientEmail String
  resendId       String?
  status         String             @default("sent") // sent, delivered, bounced, opened, clicked, complained, delivery_delayed
  errorMessage   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([broadcastId])
  @@index([resendId])
  @@map("broadcast_emails")
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postingReminder     Boolean  @default(true)
  postPublished       Boolean  @default(true)
  postFailed          Boolean  @default(true)
  newComment          Boolean  @default(true)
  analyticsMilestone  Boolean  @default(true)
  streakWarning       Boolean  @default(true)
  weeklyDigest        Boolean  @default(true)
  accountDisconnected Boolean  @default(true)
  adminBroadcast      Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("notification_preferences")
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // posting_reminder, post_published, post_failed, new_comment, analytics_milestone, streak_warning, weekly_digest, account_disconnected, admin_broadcast
  title     String
  body      String
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, type])
  @@map("notification_logs")
}

model Organization {
  id   String  @id @default(cuid())
  name String
  slug String? @unique

  seatLimit Int      @default(1)
  seatPlan  UserPlan @default(CALENDAR_ONLY)

  // Stripe-ready fields — populated by future Stripe webhook integration
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  stripeStatus         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     User[]
  teamInvites InviteToken[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("organizations")
}

// Durable, idempotent seat-reduction operation.
//
// A seat reduction touches two independent systems (Stripe + the DB) and must
// remain retryable if either side fails. This row is the single source of
// truth for an in-flight reduction: it records the original Stripe quantity,
// original seat limit, target quantity, selected member actions, actor, and
// the current state-machine status. The client generates a UUID `requestId`
// so a retry resumes the same operation instead of creating a second one.
//
// Status state machine:
//   PENDING            — claimed, validation done, Stripe call not yet applied
//   COMPLETED          — Stripe reduced AND DB member/seatLimit changes applied
//   FAILED             — retryable: Stripe rejected/timeout (members untouched)
//                        OR Stripe succeeded + DB failed + Stripe compensation
//                        succeeded (members untouched, Stripe restored)
//   RECOVERY_REQUIRED  — Stripe succeeded + DB failed + Stripe compensation
//                        also failed. Admin must intervene. The row preserves
//                        the original quantity so a human can reconcile.
//
// The Stripe reduction uses a persisted idempotency key
// (`seat_reconcile_main_<uuid>`) generated once at op creation and reused
// across retries. Compensation uses a separate persisted key
// (`seat_reconcile_comp_<op-id>`) derived from the immutable operation ID.
model SeatReconciliationOperation {
  id                        String   @id @default(cuid())
  requestId                 String   @unique
  organizationId            String
  actorUserId               String
  originalSeatLimit         Int
  originalStripeQuantity    Int?
  targetSeats               Int
  memberActionsJson         Json
  status                    String   @default("PENDING")
  attempts                  Int      @default(0)
  claimToken                String?
  claimedAt                 DateTime?
  completedAt               DateTime?
  lastError                 String?
  // Persisted Stripe idempotency keys — one per logical provider mutation.
  // Reused across retries, stale reclaims, and unknown-outcome retries so the
  // same logical mutation never sends two different keys to Stripe.
  mainIdempotencyKey        String?
  compensationIdempotencyKey String?
  // Admin recovery fields (migration 20260804200000).
  recoveryIdempotencyKey    String?
  recoveryClaimToken        String?
  recoveryClaimedAt         DateTime?
  resolvedAt                DateTime?
  resolvedByUserId          String?
  resolutionType            String?
  resolutionSummary         String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([organizationId, status])
  @@index([status, claimedAt])
  @@map("seat_reconciliation_operations")
}

model ScheduledPushNotification {
  id           String   @id @default(cuid())
  title        String
  body         String
  url          String?
  segment      String   @default("all") // all, CALENDAR_ONLY, CREATOR, PRO
  scheduledFor DateTime
  status       String   @default("PENDING") // PENDING, PROCESSING, SENT, CANCELLED, FAILED
  sentCount    Int      @default(0)
  failedCount  Int      @default(0)
  createdBy    String?
  creator      User?    @relation("ScheduledPushCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── Bounded recoverable claim state ──────────────────────────────────
  // A worker claims a due PENDING row by atomically setting status →
  // PROCESSING and stamping claimToken + claimedAt. Only the worker holding
  // claimToken may finalize the row (SENT/FAILED). Stale PROCESSING rows
  // (claimedAt older than the lease) are reclaimable by another worker.
  claimToken   String?
  claimedAt    DateTime?
  attempts     Int      @default(0)
  lastError    String?

  @@index([status, scheduledFor])
  @@index([status, claimedAt])
  @@map("scheduled_push_notifications")
}

model CalendarGenerationLog {
  id                         String   @id @default(cuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success                    Boolean
  daysGenerated              Int?
  freshnessScore             Int?
  archetypeDiversity         Float?
  themeDiversity             Float?
  hookSimilarity             Float?
  stalenessTriggered         Boolean  @default(false)
  audienceFatigueTriggered   Boolean  @default(false)
  dynamicConstraintsMode     String? // "static" | "dynamic" | "none"
  dynamicConstraintsFallback Boolean  @default(false)
  blockMetadata              Json? // { included: [], trimmed: [], omitted: [] } — no raw prompt content
  errorMessage               String?
  durationMs                 Int?
  createdAt                  DateTime @default(now())

  // ── Idempotency claim state (v3) ──────────────────────────────
  requestId                  String?  // client-generated UUID; one claim per user+requestId
  requestStatus              String?  // "PROCESSING" | "COMPLETED" | "FAILED"
  requestClaimToken          String?  // held by the process allowed to call Anthropic
  requestClaimedAt           DateTime?
  requestCompletedAt         DateTime?
  requestAttempts            Int      @default(0)
  requestDaysToPost          Int?     // inputs frozen at claim time
  requestTimezoneOffset      Int?     // inputs frozen at claim time
  requestUserId              String?  // inputs frozen at claim time (== userId; defends against token reuse across users)
  resultingCalendarId        String?  // exactly one Calendar per COMPLETED log

  calendars                  Calendar[]

  @@index([userId, createdAt])
  @@unique([userId, requestId])             // one claim per user+requestId
  @@index([requestStatus, requestClaimedAt]) // stale-lease scan
  @@map("calendar_generation_logs")
}

model ValueCallSettings {
  id             String    @id @default("default")
  title          String    @default("Next Value Call")
  description    String?
  callStartsAt   DateTime?
  zoomUrl        String?
  timezone       String?   @default("America/New_York")
  isEnabled      Boolean   @default(true)
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("value_call_settings")
}

model StripeEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  status      String    @default("PROCESSING") // PROCESSING, SUCCEEDED, FAILED
  attempts    Int       @default(1)
  claimedAt   DateTime  @default(now())
  claimToken  String
  processedAt DateTime?
  lastError   String?

  @@index([status, claimedAt])
  @@map("stripe_events")
}

model ZernioEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  status      String    @default("PROCESSING") // PROCESSING, SUCCEEDED, FAILED
  attempts    Int       @default(1)
  claimToken  String?
  claimedAt   DateTime  @default(now())
  processedAt DateTime?
  lastError   String?

  @@index([status, claimedAt])
  @@map("zernio_events")
}

model RateLimitBucket {
  key         String    @id
  count       Int       @default(0)
  windowStart DateTime
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
  @@map("rate_limit_buckets")
}

model IntegrationConnectionState {
  tokenHash  String    @id
  userId     String
  platform   String
  profileId  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("integration_connection_states")
}

enum ChangelogType {
  FEATURE
  IMPROVEMENT
  BUGFIX
  SECURITY
  ANNOUNCEMENT
}

model ChangelogEntry {
  id          String        @id @default(cuid())
  version     String?       // e.g. "v2.4.0" — optional, groups entries by release
  title       String
  type        ChangelogType @default(FEATURE)
  content     String        // Markdown or plain text description
  published   Boolean       @default(false)
  publishedAt DateTime?
  gitSha      String?       @unique // GitHub commit SHA — prevents duplicate entries from webhook/backfill
  gitAuthor   String?       // GitHub commit author name
  gitUrl      String?       // Link to commit on GitHub
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([published, publishedAt])
  @@index([version])
  @@map("changelog_entries")
}

model MemberGrowthBaseline {
  id                      String                  @id @default(cuid())
  userId                  String
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform                String
  connectionPeriodId      String?
  connectionPeriod        ImpactConnectionPeriod? @relation(fields: [connectionPeriodId], references: [id], onDelete: SetNull)
  baselineDate            DateTime
  baselineFollowerCount   Int?
  baselineEngagementRate  Float?
  baselineAvgViews        Float?
  baselineAvgInteractions Float?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([userId, platform])
  @@index([platform])
  @@index([baselineDate])
  @@index([connectionPeriodId])
  @@map("member_growth_baselines")
}

model LoginAnnouncement {
  id         String                        @id @default(cuid())
  title      String
  message    String // HTML content shown in the dismissable modal
  segment    String                        @default("all") // all, PRO, CALENDAR_ONLY, connected, unconnected
  isActive   Boolean                       @default(true)
  createdBy  String
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt
  dismissals LoginAnnouncementDismissal[]

  @@index([isActive])
  @@map("login_announcements")
}

model LoginAnnouncementDismissal {
  id            String             @id @default(cuid())
  announcementId String
  announcement  LoginAnnouncement  @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dismissedAt   DateTime           @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("login_announcement_dismissals")
}

// ─────────────────────────────────────────────────────────────────────────────
// Post Refinement Core V1
// ─────────────────────────────────────────────────────────────────────────────

enum PostStatus {
  GENERATED
  REFINED
  APPROVED
  SCHEDULED
  PUBLISHED
}

enum PostVersionSource {
  GENERATION
  AI_REFINEMENT
  MANUAL_EDIT
  RESTORE
}

enum RefinementSessionStatus {
  OPEN
  ACCEPTED
  REJECTED
  ABANDONED
}

enum RefinementMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum RefinementInputType {
  QUICK_ACTION
  FREEFORM
  SUGGESTION
  CONVERSATION
}

enum RefinementTurnStatus {
  PENDING
  PROCESSING
  COMPLETE
  ERROR
}

model Post {
  id                    String     @id @default(cuid())
  userId                String
  calendarId            String
  dayIndex              Int
  day                   String
  format                String
  bucket                String
  title                 String
  hook                  String
  body                  String
  cta                   String
  caption               String
  musicSuggestion       String?
  duration              String?
  directions            String?
  status                PostStatus @default(GENERATED)
  statusBeforePublished PostStatus?
  provenanceJson        Json?
  currentVersionId      String?    @unique
  publishedVersionId    String?    @unique
  publishedAt           DateTime?
  externalPostId        String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendar            Calendar               @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  versions            PostVersion[]          @relation("PostVersions")
  currentVersion      PostVersion?           @relation("PostCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  publishedVersion    PostVersion?           @relation("PostPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  refinementSessions  PostRefinementSession[]

  @@unique([calendarId, dayIndex])
  @@index([userId, calendarId])
  @@index([userId, status])
  @@index([calendarId, status])
  @@map("posts")
}

model PostVersion {
  id                          String              @id @default(cuid())
  postId                      String
  versionNumber               Int
  source                      PostVersionSource   @default(GENERATION)
  format                      String?
  title                       String
  hook                        String
  body                        String
  cta                         String
  caption                     String
  musicSuggestion             String?
  duration                    String?
  directions                  String?
  changeSummary               String?
  provenanceJson              Json?
  aiModel                     String?
  estimatedCostMicrodollars   Int? // microdollars — $0.0123 stored as 12300; copied from message on accept
  latencyMs                   Int?
  restoredFromVersionId       String?
  previousVersionId           String?
  createdAt                   DateTime            @default(now())

  post                   Post                   @relation("PostVersions", fields: [postId], references: [id], onDelete: Cascade)
  currentVersionOf       Post?                  @relation("PostCurrentVersion")
  publishedVersionOf     Post?                  @relation("PostPublishedVersion")
  restoredFrom           PostVersion?           @relation("RestoredFrom", fields: [restoredFromVersionId], references: [id], onDelete: SetNull)
  restoredInVersions     PostVersion[]          @relation("RestoredFrom")
  previousVersion        PostVersion?           @relation("PreviousVersion", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions           PostVersion[]          @relation("PreviousVersion")
  acceptedInSession      PostRefinementSession? @relation("SessionAcceptedVersion")
  baseVersionOfSessions  PostRefinementSession[] @relation("SessionBaseVersion")

  @@unique([postId, versionNumber])
  @@index([postId, createdAt])
  @@map("post_versions")
}

model PostRefinementSession {
  id                String                   @id @default(cuid())
  postId            String
  userId            String
  status            RefinementSessionStatus  @default(OPEN)
  baseVersionId     String?
  baseVersionNumber Int
  startedAt         DateTime                 @default(now())
  lastActivityAt    DateTime                 @default(now())
  completedAt       DateTime?
  acceptedVersionId String?                  @unique

  post            Post                     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        PostRefinementMessage[]
  turns           PostRefinementTurn[]
  acceptedVersion PostVersion?             @relation("SessionAcceptedVersion", fields: [acceptedVersionId], references: [id], onDelete: SetNull)
  baseVersion     PostVersion?             @relation("SessionBaseVersion", fields: [baseVersionId], references: [id], onDelete: SetNull)

  @@index([postId, startedAt])
  @@index([userId, startedAt])
  @@index([postId, status])
  @@index([status, lastActivityAt])
  @@map("post_refinement_sessions")
}

model PostRefinementTurn {
  id               String                @id @default(cuid())
  sessionId        String
  turnId           String                // client-generated UUID, server-validated
  status           RefinementTurnStatus  @default(PENDING)
  attemptCount     Int                   @default(0)
  processingAt     DateTime?
  completedAt      DateTime?
  lastErrorKind    String?
  lastErrorMessage String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  session PostRefinementSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, turnId])
  @@index([sessionId, status])
  @@map("post_refinement_turns")
}

model PostRefinementMessage {
  id                          String                @id @default(cuid())
  sessionId                   String
  turnId                      String                // links to PostRefinementTurn; multiple SYSTEM per turn allowed
  role                        RefinementMessageRole
  inputType                   RefinementInputType?
  actionKey                   String?
  message                     String // USER: instruction; ASSISTANT: changeSummary; SYSTEM: error/audit text
  snapshotJson                Json? // ASSISTANT only: validated proposed post fields
  instructionLength           Int?
  timeSpentMs                 Int?
  model                       String?
  promptTokens                Int?
  completionTokens            Int?
  latencyMs                   Int?
  estimatedCostMicrodollars   Int? // microdollars; calculated once on AI response
  acceptedAt                  DateTime? // set when this ASSISTANT message's snapshot is accepted
  createdAt                   DateTime              @default(now())

  session PostRefinementSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, turnId, createdAt])
  @@index([sessionId, createdAt])
  @@map("post_refinement_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Listings (V1A — Manual Listings Foundation)
// ─────────────────────────────────────────────────────────────────────────────

enum ListingSourceType {
  MANUAL
  URL_IMPORT
}

enum ListingStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ListingContentIntent {
  COMING_SOON
  JUST_LISTED
  OPEN_HOUSE
  PRICE_IMPROVEMENT
  PROPERTY_SPOTLIGHT
  UNDER_CONTRACT
  JUST_SOLD
  CUSTOM
}

enum ListingAssetType {
  SOCIAL_CAPTION
}

enum ListingContentStatus {
  GENERATED
  REFINED
  APPROVED
}

enum ListingContentVersionSource {
  GENERATION
  AI_REFINEMENT
  MANUAL_EDIT
  RESTORE
}

enum ListingComplianceStatus {
  CLEAN
  WARNING
  BLOCKED
}

enum ListingGenerationRequestStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Listing {
  id                  String            @id @default(cuid())
  userId              String
  sourceType          ListingSourceType @default(MANUAL)
  sourceUrl           String?
  normalizedSourceUrl String?
  status              ListingStatus     @default(DRAFT)

  addressLine1        String
  addressLine2        String?
  city                String
  state               String
  postalCode          String
  normalizedAddress   String
  propertyType        String
  price               Decimal?          @db.Decimal(14, 2)

  factsJson           Json
  insightsJson        Json              @default("{}")
  extractedFactsJson  Json?
  extractionMeta      Json?
  factsRevision       Int               @default(0)
  factsConfirmedAt    DateTime?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  archivedAt          DateTime?

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  content             ListingContent[]
  generationRequests  ListingGenerationRequest[]
  libraryItems        ListingLibraryItem[]

  @@unique([id, userId])
  @@index([userId, status, updatedAt])
  @@index([userId, normalizedAddress])
  @@index([userId, normalizedSourceUrl])
  @@map("listings")
}

model ListingContent {
  id                String                 @id @default(cuid())
  listingId         String
  userId            String
  intent            ListingContentIntent
  intentDataJson    Json                   @default("{}")
  assetType         ListingAssetType       @default(SOCIAL_CAPTION)
  platform          String                 @default("GENERIC")
  status            ListingContentStatus   @default(GENERATED)

  title             String                 @default("")
  hook              String
  body              String                 @default("")
  cta               String
  caption           String
  musicSuggestion   String?
  duration          String?
  directions        String?

  currentVersionId  String?                @unique
  approvedVersionId String?                @unique
  approvedAt        DateTime?
  approvalMetaJson  Json?

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  listing           Listing                @relation(fields: [listingId, userId], references: [id, userId], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions          ListingContentVersion[] @relation("ListingContentVersions")
  currentVersion    ListingContentVersion?  @relation("ListingCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  approvedVersion   ListingContentVersion?  @relation("ListingApprovedVersion", fields: [approvedVersionId], references: [id], onDelete: SetNull)
  generationRequest ListingGenerationRequest? @relation("ListingGenerationResult")
  libraryItems      ListingLibraryItem[]

  @@unique([id, userId])
  @@index([listingId, createdAt])
  @@index([userId, status, updatedAt])
  @@map("listing_contents")
}

model ListingContentVersion {
  id                        String                      @id @default(cuid())
  contentId                 String
  versionNumber             Int
  source                    ListingContentVersionSource @default(GENERATION)

  title                     String
  hook                      String
  body                      String
  cta                       String
  caption                   String
  musicSuggestion           String?
  duration                  String?
  directions                String?

  changeSummary             String?
  factsRevision             Int
  factsSnapshotJson         Json
  insightsSnapshotJson      Json
  intentDataSnapshotJson    Json
  provenanceJson            Json?
  complianceStatus          ListingComplianceStatus
  complianceIssuesJson      Json?

  aiModel                   String?
  promptTokens              Int?
  completionTokens          Int?
  estimatedCostMicrodollars Int?
  latencyMs                 Int?

  previousVersionId         String?
  restoredFromVersionId     String?
  createdAt                 DateTime                    @default(now())

  content                   ListingContent              @relation("ListingContentVersions", fields: [contentId], references: [id], onDelete: Cascade)
  currentVersionOf          ListingContent?             @relation("ListingCurrentVersion")
  approvedVersionOf         ListingContent?             @relation("ListingApprovedVersion")
  previousVersion           ListingContentVersion?      @relation("ListingVersionChain", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions              ListingContentVersion[]     @relation("ListingVersionChain")
  restoredFrom              ListingContentVersion?      @relation("ListingVersionRestore", fields: [restoredFromVersionId], references: [id], onDelete: SetNull)
  restoredInVersions        ListingContentVersion[]     @relation("ListingVersionRestore")
  libraryItems              ListingLibraryItem[]

  @@unique([id, contentId])
  @@unique([contentId, versionNumber])
  @@index([contentId, createdAt])
  @@map("listing_content_versions")
}

model ListingLibraryItem {
  id          String                @id @default(cuid())
  userId      String
  listingId   String
  contentId   String
  versionId   String
  savedAt     DateTime              @default(now())

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing     Listing               @relation(fields: [listingId, userId], references: [id, userId], onDelete: Cascade)
  content     ListingContent        @relation(fields: [contentId, userId], references: [id, userId], onDelete: Cascade)
  version     ListingContentVersion @relation(fields: [versionId, contentId], references: [id, contentId], onDelete: Cascade)

  @@unique([contentId, versionId])
  @@index([userId, savedAt])
  @@index([listingId, savedAt])
  @@map("listing_library_items")
}

model ListingGenerationRequest {
  id                 String                         @id @default(cuid())
  userId             String
  listingId          String
  requestId          String
  intent             ListingContentIntent
  requestParamsHash  String
  status             ListingGenerationRequestStatus @default(PROCESSING)
  claimToken         String
  claimedAt          DateTime
  completedAt        DateTime?
  attempts           Int                            @default(1)
  errorKind          String?
  errorMessage       String?
  resultingContentId String?                        @unique
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  listing            Listing                        @relation(fields: [listingId, userId], references: [id, userId], onDelete: Cascade)
  user               User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultingContent   ListingContent?                @relation("ListingGenerationResult", fields: [resultingContentId], references: [id], onDelete: SetNull)

  @@unique([userId, requestId])
  @@index([status, claimedAt])
  @@index([listingId, createdAt])
  @@map("listing_generation_requests")
}
